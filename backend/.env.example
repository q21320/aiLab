# 后端环境变量示例（复制为 backend/.env 使用）

# ---------------------------------------------------------------------------
# 数据库（必需）
# ---------------------------------------------------------------------------
# 连接串形式（推荐）
DATABASE_URL=postgres://ailab:ailab_dev_pwd@127.0.0.1:5432/ailab
#
# 或分别指定各项：
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=ailab
# PGPASSWORD=ailab_dev_pwd
# PGDATABASE=ailab
#
# 托管数据库通常需要 SSL：
# PGSSL=1

# ---------------------------------------------------------------------------
# AI 页面生成（可选）
# ---------------------------------------------------------------------------
# 上游为任意 OpenAI 兼容服务；密钥只保存在服务端，前端通过同源 /api/ai/generate 调用。
#
# A) 阿里云 DashScope（默认，公网 https 需要密钥）
#    AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#    AI_MODEL=qwen-max
DASHSCOPE_API_KEY=
#
# B) 本地小模型（Ollama / LM Studio / vLLM 等，本机 http 免密钥）
#    后端在 Docker 内时，指向宿主机用 host.docker.internal；同网络可用容器服务名
#    AI_BASE_URL=http://host.docker.internal:11434/v1
#    AI_MODEL=qwen2.5:7b-instruct
#    AI_API_KEY=            # 本地上游可留空
#    AI_TEMPERATURE=0.4     # 小模型出结构化 JSON 建议偏低（默认 0.4）

# ---------------------------------------------------------------------------
# 其它
# ---------------------------------------------------------------------------
# 额外允许的跨域来源（逗号分隔）。默认仅允许本机 5173/4173/3800。
# AILAB_CORS_ORIGINS=https://lab.example.com

# 台账附件（委外测试附件 / 测试结果附件等）单文件大小上限，单位 MB，默认 10（范围 1–200）。
# 附件二进制存 PostgreSQL 的 attachments 表，随数据库备份一起带走，不占容器文件系统。
# AILAB_UPLOAD_MAX_MB=10

# PORT=3800
# AILAB_HOST=0.0.0.0

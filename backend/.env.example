# 后端环境变量示例（复制为 backend/.env 使用）

# ---------------------------------------------------------------------------
# 数据库（必需）
# ---------------------------------------------------------------------------
# 连接串形式（推荐）
DATABASE_URL=postgres://ailab:ailab_dev_pwd@127.0.0.1:5432/ailab
#
# 或分别指定各项：
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=ailab
# PGPASSWORD=ailab_dev_pwd
# PGDATABASE=ailab
#
# 托管数据库通常需要 SSL：
# PGSSL=1

# ---------------------------------------------------------------------------
# AI 页面生成（可选）
# ---------------------------------------------------------------------------
# 密钥只保存在服务端，前端通过同源 /api/ai/generate 代理调用，绝不进入前端产物。
DASHSCOPE_API_KEY=
# AI_MODEL=qwen-max

# ---------------------------------------------------------------------------
# 其它
# ---------------------------------------------------------------------------
# 额外允许的跨域来源（逗号分隔）。默认仅允许本机 5173/4173/3800。
# AILAB_CORS_ORIGINS=https://lab.example.com

# PORT=3800
# AILAB_HOST=0.0.0.0

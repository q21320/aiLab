# ============================================================================
# Docker 部署环境变量（复制为 .env 使用）
#
#   cp .env.docker.example .env
#   docker compose up -d --build
# ============================================================================

# 对外访问端口（宿主机）
APP_PORT=3800

# 数据库（首次启动时由 postgres 容器创建）
DB_NAME=ailab
DB_USER=ailab
# ⚠️ 生产环境务必修改为强密码
DB_PASSWORD=ailab_dev_pwd

# AI 页面生成（可选，留空则关闭）
DASHSCOPE_API_KEY=
